// Grafana Alloy configuration for mysql-react-app-demo
// Receives OTLP from the Node.js backend and forwards to Grafana Cloud.

// ─── OTLP Receiver ────────────────────────────────────────────────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// ─── Batch Processor ──────────────────────────────────────────────────────────
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// ─── Metrics → Grafana Cloud Prometheus ───────────────────────────────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GCLOUD_PROMETHEUS_URL")
    basic_auth {
      username = env("GCLOUD_PROMETHEUS_USERNAME")
      password = env("GCLOUD_PROMETHEUS_PASSWORD")
    }
  }
}

// ─── Logs → Grafana Cloud Loki ────────────────────────────────────────────────
otelcol.exporter.loki "default" {
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = env("GCLOUD_LOKI_URL")
    basic_auth {
      username = env("GCLOUD_LOKI_USERNAME")
      password = env("GCLOUD_LOKI_PASSWORD")
    }
  }
}

// ─── Traces → Grafana Cloud Tempo ─────────────────────────────────────────────
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("GCLOUD_TEMPO_ENDPOINT")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

otelcol.auth.basic "tempo" {
  username = env("GCLOUD_TEMPO_USERNAME")
  password = env("GCLOUD_TEMPO_PASSWORD")
}
