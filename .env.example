# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=devdb
MYSQL_USER=user
MYSQL_PASSWORD=userpass

# Grafana Cloud — Alloy remote write (must match the same stack as the token)
# In Grafana Cloud: Connections → Hosted Prometheus / Loki / Tempo → Details: copy URL,
# user (numeric instance ID), and OTLP endpoint for Tempo (host:port, no https scheme).
# Use one Cloud Access Policy token with metrics:write, logs:write, traces:write as GRAFANA_CLOUD_API_KEY.
# https://grafana.com/docs/grafana-cloud/send-data/alloy/collect/
GRAFANA_CLOUD_API_KEY=

GCLOUD_PROMETHEUS_URL=
GCLOUD_PROMETHEUS_USERNAME=
GCLOUD_PROMETHEUS_PASSWORD=

GCLOUD_LOKI_URL=
GCLOUD_LOKI_USERNAME=
GCLOUD_LOKI_PASSWORD=

GCLOUD_TEMPO_ENDPOINT=
GCLOUD_TEMPO_USERNAME=
GCLOUD_TEMPO_PASSWORD=

# Faro Frontend Observability — create an app in Grafana Cloud → Frontend → Apps
# Then paste the App Key and collector URL here
VITE_FARO_APP_KEY=your_faro_app_key
VITE_FARO_ENDPOINT=https://faro-collector-prod-us-central-0.grafana.net/collect
